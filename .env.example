DB_HOST=127.0.0.1
DB_NAME=vesfinder
DB_USER=root
DB_PASSWORD=

# Canonical public URL (emails, absolute API hints). Use https:// in production.
APP_URL=http://localhost:8080

# Session cookie (production behind TLS terminator: set TRUST_X_FORWARDED_PROTO=1 only if nginx/proxy sets X-Forwarded-Proto; do not enable on an untrusted network path.)
# SESSION_COOKIE_SECURE=1
# TRUST_X_FORWARDED_PROTO=1
# SESSION_COOKIE_SAMESITE=Lax

# Docker Compose sets DB_HOST=db, DB_PASSWORD=vesfinder_root — override in .env only if needed.

# Comma-separated SOS / alert notification recipients (optional)
BVF_OPS_EMAILS=
